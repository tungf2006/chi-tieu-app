# Template environment file.
# Copy to `.env` and set real values:  cp .env.example .env
# `.env` is gitignored; this file is committed as a safe template.

# PostgreSQL password used by the `db` service (docker-compose.yml)
POSTGRES_PASSWORD=change_me_strong_password

# Full DB connection string used by the `api` service.
# Host MUST be the compose service name "db", not "localhost".
DATABASE_URL=postgresql://postgres:change_me_strong_password@db:5432/chitieu_db
